# --- 9Router (server-side only, never expose to the browser) ---
# Base URL of your 9Router instance. With or without "/v1" — both work:
#   ROUTER_API_URL=https://r4je36b.abc-tunnel.us/v1
#   ROUTER_API_URL=https://your-relay.vercel.app
# The app observes realtime request activity via the router's built-in
# SSE endpoint <base>/api/usage/stream (no monitoring endpoint assumptions).
# Leave empty to run in development/simulator mode.
ROUTER_API_URL=
ROUTER_API_KEY=
